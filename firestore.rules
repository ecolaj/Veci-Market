rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { 
      return request.auth != null && 
      (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || 
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'banned'); 
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'display_name', 'role', 'created_at']) &&
             data.email is string && data.email.size() <= 200 &&
             data.display_name is string && data.display_name.size() <= 200 &&
             data.role is string && data.role in ['buyer', 'vendor', 'admin'] &&
             data.created_at is timestamp;
    }

    match /users/{userId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.auth.uid == userId; // && isValidUser(incoming());
      allow update: if (isSignedIn() && request.auth.uid == userId && incoming().role == existing().role) || isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin(); // Only seeded
    }

    function isValidClassified(data) {
      return data.keys().hasAll(['vendor_id', 'category_id', 'title', 'description', 'price', 'created_at', 'status']) &&
             data.vendor_id is string && data.vendor_id == request.auth.uid &&
             data.category_id is string &&
             data.title is string && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 2000 &&
             data.price is number && data.price >= 0 &&
             data.status is string && data.status in ['active', 'inactive'];
    }

    match /classifieds/{classifiedId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidClassified(incoming());
      allow update: if (isSignedIn() && existing().vendor_id == request.auth.uid &&
                    incoming().vendor_id == existing().vendor_id) || isAdmin();
      allow delete: if (isSignedIn() && existing().vendor_id == request.auth.uid) || isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (existing().buyer_id == request.auth.uid || existing().vendor_id == request.auth.uid);
      allow create: if isSignedIn() && incoming().buyer_id == request.auth.uid;
      allow update: if isSignedIn() && (
        (existing().vendor_id == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at', 'cancel_reason'])) ||
        (existing().buyer_id == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at', 'cancel_reason']))
      );
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().user_id == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().user_id == request.auth.uid;
    }
  }
}
