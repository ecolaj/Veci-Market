# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Auth and Database config
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Firebase Admin Service Account Key JSON (for native push notifications)
# Open Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Paste the ENTIRE JSON file content here on a single line:
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase VAPID Key (Obligatorio para Web Push en iOS Safari)
# Open Firebase Console -> Project Settings -> Cloud Messaging -> Generar par de claves (Web Push certificates)
VITE_FIREBASE_VAPID_KEY=
